# Set these in the server environment. Never put the Last.fm key in the app.
VIBECUT_TOKEN=replace-with-a-long-random-token
LASTFM_API_KEY=
# Optional browser preview origin. Native apps do not use CORS.
VIBECUT_WEB_ORIGIN=http://localhost:8081
# Set to your actual private HTTPS hostname when reverse-proxying the server.
VIBECUT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
